default_platform(:ios)

# Run from the ios/ directory: `bundle exec fastlane <lane>`.
# The Xcode project is generated by xcodegen from App/project.yml (it is
# gitignored), so every lane regenerates it first. Paths are resolved from this
# file's location so the lanes don't depend on the current working directory.

APP_DIR   = File.expand_path("../App", __dir__)             # ios/App
XCODEPROJ = File.join(APP_DIR, "EvanProxyApp.xcodeproj")
SCHEME    = "EvanProxyApp"

platform :ios do
  desc "Regenerate the Xcode project from App/project.yml (skips if xcodegen is absent)"
  lane :generate do
    if `which xcodegen`.strip.empty?
      UI.important("xcodegen not on PATH — install with `brew install xcodegen`")
    else
      sh("cd #{APP_DIR.shellescape} && xcodegen generate")
    end
  end

  desc "Build a signed App Store archive and upload it to TestFlight"
  desc "Needs an App Store Connect API key (Users and Access > Integrations),"
  desc "e.g. via app_store_connect_api_key before this lane, or the"
  desc "APP_STORE_CONNECT_API_KEY_* env vars fastlane reads automatically."
  lane :beta do
    generate
    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store"
    )
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
