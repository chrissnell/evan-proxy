# evan-proxy iOS — version + project tasks
#
# Run from the ios/ directory: `make <target>`.
#
# The app version lives in App/project.yml (MARKETING_VERSION is the public
# x.y.z string; CURRENT_PROJECT_VERSION is the build number, which must strictly
# increase for every App Store upload). These targets rewrite it and regenerate
# the Xcode project (App/EvanProxyApp.xcodeproj is gitignored — generated by
# xcodegen). The repo's root Makefile bump-* targets are for the Go release
# tags, not this app.

PROJECT_YML := App/project.yml

.DEFAULT_GOAL := help
.PHONY: help version generate beta bump-point bump-minor bump-major bump-build

help: ## Show this help
	@grep -E '^[a-zA-Z0-9_-]+:.*## ' $(MAKEFILE_LIST) | \
		awk 'BEGIN {FS = ":.*## "} {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'

# --- Project ---------------------------------------------------------------
generate: ## Regenerate the Xcode project from App/project.yml
	cd App && xcodegen generate

beta: ## Build and upload to TestFlight (fastlane; needs an ASC API key)
	bundle exec fastlane beta

# --- Version bumping -------------------------------------------------------
version: ## Print the current version and build number
	@printf "version %s (build %s)\n" \
		"$$(grep -m1 'MARKETING_VERSION:' $(PROJECT_YML) | sed -E 's/.*MARKETING_VERSION:[[:space:]]*"?([^"[:space:]]+)"?.*/\1/')" \
		"$$(grep -m1 'CURRENT_PROJECT_VERSION:' $(PROJECT_YML) | sed -E 's/.*CURRENT_PROJECT_VERSION:[[:space:]]*//')"

bump-point: ## Bump patch version (1.0.0 -> 1.0.1) and the build number
	$(call do_bump,patch)

bump-minor: ## Bump minor version (1.0.0 -> 1.1.0) and the build number
	$(call do_bump,minor)

bump-major: ## Bump major version (1.0.0 -> 2.0.0) and the build number
	$(call do_bump,major)

bump-build: ## Increment only the build number (re-upload same version)
	$(call do_bump,build)

# $(call do_bump,<major|minor|patch|build>)
define do_bump
	@current=$$(grep -m1 'MARKETING_VERSION:' $(PROJECT_YML) | sed -E 's/.*MARKETING_VERSION:[[:space:]]*"?([^"[:space:]]+)"?.*/\1/'); \
	build=$$(grep -m1 'CURRENT_PROJECT_VERSION:' $(PROJECT_YML) | sed -E 's/.*CURRENT_PROJECT_VERSION:[[:space:]]*//'); \
	major=$$(echo $$current | cut -d. -f1); \
	minor=$$(echo $$current | cut -d. -f2); \
	patch=$$(echo $$current | cut -d. -f3); \
	case "$(1)" in \
	  major) major=$$((major + 1)); minor=0; patch=0 ;; \
	  minor) minor=$$((minor + 1)); patch=0 ;; \
	  patch) patch=$$((patch + 1)) ;; \
	  build) ;; \
	  *) echo "unknown bump part: $(1)"; exit 1 ;; \
	esac; \
	newversion="$$major.$$minor.$$patch"; \
	newbuild=$$((build + 1)); \
	sed -i.bak -E "s/MARKETING_VERSION:[[:space:]].*/MARKETING_VERSION: \"$$newversion\"/; s/CURRENT_PROJECT_VERSION:[[:space:]].*/CURRENT_PROJECT_VERSION: $$newbuild/" $(PROJECT_YML); \
	rm -f $(PROJECT_YML).bak; \
	echo "$$current (build $$build) -> $$newversion (build $$newbuild)"; \
	if command -v xcodegen >/dev/null 2>&1; then (cd App && xcodegen generate); \
	else echo "note: xcodegen not found — run 'xcodegen generate' in ios/App to apply"; fi
endef
